# Build host details and retired scripts (see build/)
/build/hosts.env
/build/legacy/

!/build/tools/
# Mesa3D software-OpenGL DLLs (*.dll) are fetched by build/tools/get-mesa.sh; its download scratch space is never committed.
/mesa-staging/
# Mesa3D software-OpenGL DLLs: fetched per build host by build/tools/get-mesa.sh, never committed.
/assets/mesa-win/*.dll

# Mesa3D fallback: its helper scripts are tracked (with the version pin, licence texts and markers in assets/mesa-win);
# build scripts, the DLLs and the download scratch space are not.
!/build/tools/get-mesa.sh
!/build/tools/check_mesa_updates.sh
!/build/tools/fetch_mesa_licenses.sh
